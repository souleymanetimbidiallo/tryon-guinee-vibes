# TryOn Guinée - Variables d'environnement (OPTIONNEL)

# L'application fonctionne en mode démo sans ces variables
# Configurez-les uniquement si vous voulez utiliser une vraie API IA

# URL de l'API IA pour la génération d'images
VITE_GENAI_API_URL=https://api.example-ia.com/generate

# Clé API pour l'authentification
VITE_GENAI_API_KEY=votre-clé-api-ici

# Modèle IA à utiliser (exemple: nano-banana-v2, gemini-2.5-flash-image-preview)
VITE_GENAI_MODEL=nano-banana-v2

# Pour utiliser ces variables:
# 1. Copiez ce fichier en .env.local
# 2. Remplissez vos vraies valeurs
# 3. Redémarrez le serveur de développement
